[sub_resource type="GDScript" id="GDScript_uetju"]
script/source = "extends HBoxContainer

func _physics_process(delta: float) -> void:
	for c in get_children():
		c.texture.region = Rect2(64.0, 0.0, 64, 64)
	pass
"

