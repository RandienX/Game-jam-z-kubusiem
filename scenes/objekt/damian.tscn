[sub_resource type="GDScript" id="GDScript_c4t51"]
script/source = "extends HBoxContainer

func _physics_process(delta: float) -> void:
	var energy = $\"../../..\".wall_jumps_remaining
	for c in range(len(get_children())):
		get_child(c).texture.region = Rect2(0.0, 64.0, 64, 64)
		if c < energy:
			get_child(c).texture.region = Rect2(64.0, 64.0, 64, 64)
		
"

